{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QxChat",
  "version": "1.15.2",
  "identifier": "com.qxp.client",
  "build": {
    "beforeDevCommand": "cd client && bun install --no-save && bun vite --host 0.0.0.0",
    "beforeBuildCommand": "cd client && bun run build:tauri",
    "devUrl": "http://localhost:4173/#/",
    "frontendDist": "../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QxChat",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NEYyQzVGRUQwMjIzODQKUldTRUl3THRYeXhQNVRiVzN5T2xDL1h5RkR2LzJ6KzFYangwVjZ1UUcrT0J0NkFYWUx5SzJiUzAK",
      "endpoints": [
        "https://github.com/lqxp/app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": null
    }
  }
}
