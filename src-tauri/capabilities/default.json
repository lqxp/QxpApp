{
  "identifier": "main-messaging",
  "description": "Permissions for the QXP messaging web client in the main window.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:webview:allow-create-webview-window",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "screen-audio:allow-start",
    "screen-audio:allow-stop",
    "background:allow-start-background",
    "background:allow-stop-background",
    "background:allow-is-background-running",
    "tor:allow-status",
    "tor:allow-start",
    "tor:allow-stop",
    "tor:allow-is-ready",
    "tor:allow-relays",
    "tor:allow-circuit",
    "tor:allow-geo",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://qxch.at/*"
        },
        {
          "url": "https://github.com/*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "https://metrics.torproject.org/*"
        }
      ]
    }
  ]
}
